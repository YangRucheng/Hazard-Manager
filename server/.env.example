# 电气车间隐患闭环系统后端配置示例
# 复制为 server/.env 并按需修改；JWT_SECRET 与 ADMIN_PASSWORD 必填，缺失时服务拒绝启动。

# 服务端口（8080 被占用，默认 8090）
SERVER_PORT=8090

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hazard
DB_PASSWORD=hazard_dev_password
DB_NAME=hazard_system

# JWT（HS256）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TOKEN_TTL_MINUTES=1440

# 管理用户（唯一 admin，密码不入数据库）
ADMIN_PASSWORD=admin123456

# 图片存储
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# 跨域（CORS）：默认放开——按请求 Origin 回显，缺失时按 Referer 解析，
# 均无则使用 *（鉴权走 Bearer 头，不依赖 Cookie，无需精确白名单）。
# 如需更严格策略，可在路由层自行扩展。